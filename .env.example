# Copy to .env and fill in. Every variable below is imported by the app through $env/static, so a
# build or dev server fails if one is missing. Use the DEV Firebase project (lehman-realty-dev) for
# local work: pointing a local .env at production means local runs touch production data.

# Firebase web app config (Firebase console > Project settings > General > Your apps)
PUBLIC_FB_PROJECT_ID=
PUBLIC_FB_API_KEY=
PUBLIC_FB_AUTH_DOMAIN=
PUBLIC_FB_STORAGE_BUCKET=
PUBLIC_FB_MESSAGING_SENDER_ID=
PUBLIC_FB_APP_ID=
PUBLIC_FB_MEASUREMENT_ID=

# Base URL of this app, used in Stripe return URLs and in password reset and welcome emails.
PUBLIC_FRONTEND_URL=http://localhost:5173

# Firebase Admin service account (Project settings > Service accounts).
FB_CLIENT_EMAIL=
# A JSON string with one key, NOT the raw PEM. The private key's newlines stay as \n escapes:
#   FB_PRIVATE_KEY='{"privateKey": "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"}'
# For a build that never talks to Firebase, a throwaway key works:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log(\"FB_PRIVATE_KEY='\"+JSON.stringify({privateKey})+\"'\")"
FB_PRIVATE_KEY=

SENDGRID_API_KEY=

# Stripe test-mode keys for local work.
STRIPE_API_KEY=
STRIPE_ENDPOINT_SECRET=
