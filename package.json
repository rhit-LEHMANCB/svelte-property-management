{
	"name": "svelte-budget-web-app",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": "22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run tests/unit",
		"test:handlers": "vitest run tests/handlers",
		"test": "vitest run",
		"test:e2e": "firebase emulators:exec --config firebase.emulators.json --project demo-lehman-realty --only auth,firestore,storage \"playwright test --project=e2e\"",
		"test:qa": "PLAYWRIGHT_QA=1 playwright test --project=qa"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@playwright/test": "^1.63.0",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.0.0",
		"@types/validator": "^13.15.0",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"firebase": "^12.0.0",
		"firebase-tools": "^15.32.1",
		"globals": "^17.0.0",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^4.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"sveltekit-superforms": "^3.0.0",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.0.0",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@sendgrid/mail": "^8.1.6",
		"@tabler/icons-svelte": "^3.49.0",
		"firebase-admin": "^14.0.0",
		"google-maps": "^4.3.3",
		"stripe": "^23.0.0",
		"ts-input-mask": "^2.2.0",
		"validator": "^13.15.0",
		"vite": "^8.0.0",
		"zod": "^4.0.0"
	}
}
